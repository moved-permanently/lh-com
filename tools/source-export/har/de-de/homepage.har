light.territorialContinuity.modalHeadlineTriesteFirstStep\":\"The selected route includes flights with territorial continuity\",\"flightmanager.flight.travelDetails.destNotAvailableForCug\":\"Dieses Reiseziel ist mit Ihrem Zugangscode nicht verf\u00fcgbar.\",\"flightmanager.flight.territorialContinuity.infantsStepperHint\":\"0-23 months\",\"flightmanager.config.territorialContinuity.romToAhoDates\":\"/2026-03-28\",\"flightmanager.flight.travelDetails.openButtonLabel\":\"Passagier- und Reiseklasse-Auswahl\",\"flightmanager.config.territorialContinuity.milToTrsDates\":\"/2026-03-28\",\"flightmanager.promotionTeaser.default.conditionLinkLabel\":\"Conditions\",\"flightmanager.destinationTeaser.default.teaserButton\":\"Neugierig? Entdecken Sie Ihr Reiseziel!\",\"flightmanager.flight.accessCode.error.maxLength\":\"Ihr Zugangscode darf 15 Zeichen nicht \u00fcberschreiten.\",\"flightmanager.flight.dateInputGrouped.oneway\":\"Hinflug\",\"flightmanager.config.territorialContinuity.romToPmoDates\":\"/2026-07-31\",\"flightmanager.flight.od.startDateErrorType\":\"Bitte geben Sie Ihr Abflugdatum ein und versuchen es erneut.\",\"flightmanager.flight.travelDetails.farePreferenceDefault\":\"Bestpreisangebote\",\"flightmanager.flight.travelDetails.accessCodeFieldHidden\":\"Das Eingabefeld f\u00fcr einen Zugangscode ist nicht verf\u00fcgbar.\",\"flightmanager.flight.od.returnDateRequired\":\"Bitte geben Sie Ihr R\u00fcckflugdatum ein und versuchen es erneut.\",\"flightmanager.flight.territorialContinuity.sicilyImportantInfoTimeToThink\":\"It will not be possible to choose the \u201cTime to Think\u201d feature\",\"flightmanager.hotel.checkin.label\":\"Anreisedatum\",\"flightmanager.flight.od.mamStatusError\":\"Ihr Miles & More-Status berechtigt Sie nicht zur Nutzung des ausgew\u00e4hlten Zugangscodes.\",\"flightmanager.flight.territorialContinuity.importantContentTrieste\":\"<p>At any time, the customer may be asked to produce documentation confirming they belong to one of the categories indicated above.<br />\\r\\n<br />\\r\\nITA Airways reserves the right to prosecute via the relevant authorities any persons who are not eligible for the discounted fare selected.<br />\\r\\n<br />\\r\\nTo purchase tickets for unaccompanied minor passengers, please refer to the Customer Center. Our online sales service is free of charge.</p>\\r\\n\",\"flightmanager.holiday.default.duration\":\"Reisedauer\",\"flightmanager.flight.accessCode.error.universalCode\":\"Ung\u00fcltiges Format des Zugangscodes.\",\"flightmanager.flight.travelDetails.infantsSeatErrorMaximum\":\"Aus Sicherheitsgr\u00fcnden muss pro Kleinkind ein Erwachsener mitreisen.\",\"flightmanager.car.category.all\":\"Alle\",\"flightmanager.flight.voucherCode.label\":\"Gutscheincode\",\"flightmanager.flight.od.invalidDates\":\"Die Daten sind f\u00fcr diesen Zugangscode nicht w\u00e4hlbar.\",\"flightmanager.flight.territorialContinuity.disabledStepperLabel\":\"Disabled people\",\"flightmanager.hotel.cityName.errorMinLength\":\"Der angegebene Name des Zielorts ist zu kurz\",\"flightmanager.config.territorialContinuity.isSicilyDiscountDisabled\":\"N\",\"flightmanager.flight.multicity.headline\":\"Flugsegment {NUMBER}\",\"flightmanager.flight.territorialContinuity.backButtonText\":\"Back\",\"flightmanager.holiday.checkInDate.errorRequired\":\"Bitte geben Sie Ihr Hinflugdatum ein.\",\"flightmanager.flight.travelDetails.allegrisMessageLink\":\"https://www.lufthansa.com/{MARKET}/{LANGUAGE}/advance-seat-reservation#first\",\"flightmanager.flight.stopover.lengthStepperLabel\":\"N\u00e4chte\",\"flightmanager.flight.stopover.stopoverLearnMoreLinkUrl\":\"https://www.lufthansa.com/{MARKET}/{LANGUAGE}/book-and-manage/stopover\",\"flightmanager.flight.calendar.clearReturnDate.label\":\"R\u00fcckflugdatum l\u00f6schen\",\"flightmanager.flight.swapButton.label\":\"Klicken Sie hier um Abflug- {ORIGIN} und Zielort {DESTINATION} zu tauschen.\",\"flightmanager.flight.territorialContinuity.seniorsStepperHint\":\"from 70 years old\",\"flightmanager.flight.voucherCode.hint\":\"Gutscheincode hier eingeben\",\"flightmanager.flight.stopover.addStopoverSwitch\":\"Stopover in M\u00fcnchen hinzuf\u00fcgen\",\"flightmanager.flight.travelDetails.farePreferenceLow\":\"Low\",\"flightmanager.destinationTeaser.default.teaserInfo\":\"{DESTINATION} - Preise ab {CURRENCYSYMBOL} {PRICE} \",\"flightmanager.flight.territorialContinuity.faresInfoParagraphTrieste\":\"The fares for these flights will be differentiated based on whether or not they belong to the following categories of passengers (without any discrimination related to place of birth or nationality):\",\"flightmanager.flight.useMiles.registerLink\":\"Registrieren\",\"flightmanager.flight.travelDetails.accessCodeApplied\":\"Ihr Zugangscode wurde angewendet.\",\"flightmanager.car.category.hint\":\"\",\"flightmanager.flight.territorialContinuity.importantHeadline\":\"Important\",\"flightmanager.holiday.traveller.adults\":\"Erwachsene\",\"flightmanager.flight.travelDetails.personalTravelChosenSR\":\"Es sind zus\u00e4tzliche Tarifoptionen f\u00fcr Ihre Reise verf\u00fcgbar.\",\"flightmanager.config.holiday.durationsList\":\"-1,7,14,21,1-3,2-3,3-5,5-7,7-12,10-14,1,2,3,4,5,6,8,9,10,11,12,13,15\",\"flightmanager.car.dropoff.locationRequired\":\"Bitte geben Sie Ihre R\u00fcckgabestation ein.\",\"flightmanager.hotel.checkin.hint\":\"\",\"flightmanager.destinationTeaser.default.destination\":\"{DESTINATION}\",\"flightmanager.flight.useMiles.registerLinkSR\":\"Klicken Sie auf den Button, um sich zu registrieren.\",\"flightmanager.flight.useMiles.awardFlowTitle\":\"Miles & More Pr\u00e4mienflugbuchung\",\"flightmanager.flight.links.voucherCode\":\"Ich habe einen Gutscheincode.\",\"flightmanager.common.default.studentStatusVerificationButtonSrInfo\":\"On click, this button will open a modal with form provided by SheerID allowing for student status verification\",\"flightmanager.flight.useMiles.flightAwardsButton\":\"Award Flight suchen\",\"flightmanager.flight.stopover.add\":\"Stopover in M\u00fcnchen hinzuf\u00fcgen\",\"flightmanager.hotel.checkout.afterCheckin\":\"Check-Out has to be after Check-In.\",\"flightmanager.flight.territorialContinuity.sicilyResidentsSectionContent\":\"At the time of making the online purchase of the ticket, it will be necessary to enter the details of the traveler\u2019s document or residence permit for European citizens and the Municipality of Residence so as to prove eligibility and demonstrate to the airline, by means of self-declaration, his or her status <strong>as a Sicilian resident.</strong><br>\\r\\n\",\"flightmanager.flight.useMiles.cashAndMilesHeadline\":\"Cash & Miles\",\"flightmanager.car.dropoff.locationHint\":\"\",\"flightmanager.flight.od.destinationCodeErrorRequired\":\"Bitte geben Sie Ihr Reiseziel ein und versuchen Sie es erneut.\",\"flightmanager.flight.territorialContinuity.sicilyImportantInfoPaymentForms\":\"The discount cannot be combined with other forms of payment such as gift cards or discount codes\",\"flightmanager.car.pickup.timeRequired\":\"Bitte w\u00e4hlen Sie eine Uhrzeit aus.\",\"flightmanager.flight.accessCode.hint\":\"Dieses Feld ist nur f\u00fcr Zugangscodes (max. 15\u00a0Zeichen). Falls Sie einen Aktionscode haben, geben Sie ihn bitte auf der Bezahlseite ein.\",\"flightmanager.holiday.traveller.childrenGroup\":\"Reisen mit Kindern\",\"flightmanager.flight.territorialContinuity.winterWorker\":\"Worker (only on winter season)\",\"flightmanager.flight.useMiles.awardFlowBookingForOtherPerson\":\"Ich buche f\u00fcr jemand anderen und fliege nicht selbst.\",\"flightmanager.flight.travelDetails.dismissedPrefix\":\"Dismissed:\",\"flightmanager.flight.travelDetails.openButtonInfo\":\"{CABIN}, {TRAVELLERS_COUNT, plural, =0 {} one {1 {TRAVELLER}} other {{TRAVELLERS_COUNT} {TRAVELLERS}}}{ACCESS_CODE_APPLIED}{CUG_CODE_APPLIED}{FARE_PREFERENCE_APPLIED}\",\"flightmanager.flight.useMiles.headline\":\"Sie haben zwei M\u00f6glichkeiten, Ihre Meilen einzul\u00f6sen.\",\"flightmanager.flight.links.whereWeFlyHref\":\"https://www.lufthansa.com/xx/de/fluege\",\"flightmanager.promotionTeaser.default.fallbackButtonLabel\":\"G\u00fcnstigste Preise pr\u00fcfen\",\"flightmanager.flight.territorialContinuity.childrenStepperLabel\":\"Children\",\"flightmanager.flight.oneway.label\":\"Einfacher Flug\",\"flightmanager.flight.territorialContinuity.notificationTextTrieste\":\"Decree of the Italian Ministry of Infrastructure and Transport No. 96 of 12 April 2023\",\"flightmanager.config.holiday.lufthansaHolidaysTargetUrl\":\"https://www.lufthansaholidays.com\",\"flightmanager.flight.travelDetails.youthsLabel\":\"Youth\",\"flightmanager.flight.stopover.selectArrivalOption\":\"R\u00fcckflug\",\"flightmanager.flight.territorialContinuity.sicilyDiscountDisabledNotificationText\":\"Sorry, the discount for Sicily residents is no longer available. Please continue with a normal booking\",\"flightmanager.flight.territorialContinuity.nonResidentsTravelingDescription\":\"For non-residents traveling to Sardinia for work reasons during the IATA winter season (from 27 October 2024 to 29 March 2025), in order to access this fare, the documentation with which the employer certifies the transfer of the employee or, in the case of freelancers, a self-certification and the presentation of the card of the professional. The form must be printed, completed and presented at boarding, accompanied by a valid identity document.<br>\\r\\n\",\"flightmanager.flight.useMiles.tabName\":\"Meilen einl\u00f6sen\",\"flightmanager.flight.autosuggest.recentSearches\":\"Letzte Suchanfragen\",\"flightmanager.flight.territorialContinuity.pleaseNoteHeadline\":\"Please note\",\"flightmanager.flight.territorialContinuity.pleaseNoteContentTrieste\":\"<p>It is not possible to purchase, in a single web transaction, airline tickets for passengers who meet the requirements for discounted fares together with those for passengers who do not meet these requirements.<br />\\r\\n<br />\\r\\nMoreover, it is not possible to merge multiple passenger types into one reservation (you will need to make different reservations).</p>\\r\\n\",\"flightmanager.flight.territorialContinuity.youngPeople\":\"Young people (from 2 to 21 years)\",\"flightmanager.flight.travelDetails.concorButtonText\":\"Gesch\u00e4ftsreisen, {CABIN}\",\"flightmanager.flight.accessCode.mamStatusError\":\"Der eingegebene Zugangscode kann mit Ihrem Miles & More Status nicht verwendet werden.\",\"flightmanager.flight.territorialContinuity.residentsInFriuliDescription\":\"Valid ID document certifying actual residence in Friuli-Venezia Giulia.\",\"flightmanager.car.dropoff.timeLabel\":\"Uhrzeit\",\"flightmanager.hotel.checkout.label\":\"Abreisedatum\",\"flightmanager.flight.od.originCodeErrorRequired\":\"Bitte geben Sie Ihren Abflugort ein und versuchen es erneut.\",\"flightmanager.holiday.default.searchButton\":\"Reise suchen\",\"flightmanager.config.territorialContinuity.romToCtaDates\":\"/2026-07-31\",\"flightmanager.car.pickup.locationRequired\":\"Bitte geben Sie Ihre Anmietstation ein.\",\"flightmanager.flight.territorialContinuity.universityStudents\":\"University students (18-26 years)\",\"flightmanager.car.category.errorRequired\":\"Bitte w\u00e4hlen Sie eine Fahrzeugklasse aus.\",\"flightmanager.flight.territorialContinuity.modalHeadlineSardinia\":\"On the selected route, there are flights with territorial continuity fares\",\"flightmanager.flight.territorialContinuity.requestedDocumentsCollapsibleTab\":\"Requested documents for each category section\",\"flightmanager.flight.od.endDateErrorRequired\":\"Bitte geben Sie Ihr R\u00fcckflugdatum ein und versuchen es erneut.\",\"flightmanager.flight.travelDetails.segmentCodesFetchError\":\"Das Laden Ihrer Segmentcodes ist fehlgeschlagen. \u00d6ffnen Sie das Modal erneut, um es noch einmal zu versuchen.\",\"flightmanager.flight.stopover.selectDepartureOption\":\"Hinflug\",\"flightmanager.flight.travelDetails.farePreferenceMedium\":\"Medium\",\"flightmanager.flight.territorialContinuity.seniorResidentsStepperLabel\":\"Residents\",\"flightmanager.flight.od.invalidRoute\":\"Die Reiseverbindung ist entweder zu dem ausgew\u00e4hlten Zeitraum nicht verf\u00fcgbar, online nicht buchbar oder wird von unser Fluggesellschaft nicht angeboten.\",\"flightmanager.flight.useMiles.flightAwardsButtonSR\":\"Klicken Sie auf den Button, um nach Pr\u00e4mienfl\u00fcgen zu suchen.\",\"flightmanager.car.pickup.dateRequired\":\"Bitte geben Sie Ihr Anmietdatum ein.\",\"flightmanager.flight.territorialContinuity.disabled\":\"Disabled (no discount for accompanying persons)\",\"flightmanager.flight.travelDetails.cugCodeApplied\":\"Ihr Zugangscode wurde angewendet.\",\"flightmanager.flight.territorialContinuity.studentsStepperHint\":\"University students (18-26 years)\",\"flightmanager.flight.territorialContinuity.youthStepperHint\":\"From 12 to under 14 years of age, either the minor must travel with a responsible adult, or the procedure for unaccompanied minors must be activated via the Contact Center\",\"flightmanager.flight.travelDetails.tripTypeLabel\":\"Art der Reise\",\"flightmanager.hotel.checkout.errorRequired\":\"Bitte geben Sie Ihr Abreisedatum ein.\",\"flightmanager.flight.accessCode.label\":\"Zugangscode\",\"flightmanager.flight.territorialContinuity.paragraphPleaseNote\":\"Please note, it will not be possible to merge multiple passenger types into one reservation (you will need to make different reservations)\",\"flightmanager.flight.territorialContinuity.studentsUnder\":\"Students under 27 years of age (Residents in Friuli-Venezia Giulia)\",\"flightmanager.config.territorialContinuity.milToCtaDates\":\"/2026-07-31\",\"flightmanager.flight.territorialContinuity.notificationTextSardinia\":\"Decree of the Italian Ministry of Sustainable Infrastructure and Mobility (today, Ministry of Infrastructure and Transport) No. 466 of 25 November 2021, and subsequent amendments\",\"flightmanager.flight.calendar.clearOutboundDate.label\":\"Abflugdatum l\u00f6schen\",\"flightmanager.flight.useMiles.infantAwardBookingError\":\"Award Flights f\u00fcr Kleinkinder unter 2 Jahren k\u00f6nnen nur \u00fcber das Miles & More Service Team gebucht werden. Sie k\u00f6nnen Ihre Award Flights ohne Kleinkind online buchen und das Service Team anschlie\u00dfend mit Ihrem Buchungscode kontaktieren.\",\"flightmanager.flight.territorialContinuity.importantContentSardinia\":\"<p>At any time, the customer may be asked to produce documentation that confirms they belong to one of the categories indicated above.<br />\\r\\n<br />\\r\\nTo purchase tickets for unaccompanied minor passengers, please refer to the customer center.<br />\\r\\nITA Airways reserves the right to prosecute via the relevant authorities any persons who are not eligible for the discounted fare selected. Please be informed that our online sales service is free of charge.</p>\\r\\n\",\"flightmanager.config.flight.cugSegmentsFetchingUrl\":\"https://api.travelid.lufthansa.com/cug/v1/me/user-group?status=ACTIVE \",\"flightmanager.flight.useMiles.flightAwardsHeadline\":\"Pr\u00e4mienfl\u00fcge buchen\",\"flightmanager.hotel.default.searchButton\":\"Hotelsuche\",\"flightmanager.flight.territorialContinuity.sicilyImportantInfoAllowedCards\":\"Payment can only be made by credit/debit card (PayPal, Apple Pay and bank transfers are excluded)\",\"flightmanager.flight.territorialContinuity.winterWorkerStepperLabel\":\"Worker\",\"flightmanager.car.moreLink.default\":\"Erweiterte Suchoptionen\",\"flightmanager.flight.useMiles.awardFlowDescription\":\"Wenn Sie diese Option aktivieren, k\u00f6nnen Sie Ihre Meilen f\u00fcr Pr\u00e4mienfl\u00fcge einl\u00f6sen. Bitte beachten Sie, dass Sie zum Miles & More-Pr\u00e4mienbuchungsprozess weitergeleitet werden.\",\"flightmanager.flight.od.departureDateInPast\":\"Ihr Abflugdatum liegt in der Vergangenheit. Bitte w\u00e4hlen Sie ein g\u00fcltiges Datum.\",\"flightmanager.config.flight.b2PrefetchScriptUrl\":\"https://shop.lufthansa.com/booking/api/prefetch\",\"flightmanager.flight.territorialContinuity.sicilyFaresInfoBottomParagraph\":\"<p>It is not possible to purchase, in a single web transaction, airline tickets for passengers who meet the requirements for discounted fares together with those for passengers who do not meet these requirements.<br />\\r\\n<br />\\r\\nMoreover, it is not possible to merge multiple passenger types (residents and non-residents) into one reservation (you will need to make different reservations).<br />\\r\\n<br />\\r\\nPlease note: upon boarding, the customer may be asked to produce documentation confirming they belong to the category indicated above.<br />\\r\\n<br />\\r\\nTickets for <strong>&quot;Priority Categories&quot; can be purchased online at the standard discount</strong> (as indicated in the D.D.G. Director General&#39;s Decree - No. 3158 of 10 November, 2023, from the Department of Infrastructures and Mobility of the Sicily Region - Department of Infrastructures, Mobility and Transportation). The refund of the additional contribution for &#39;Priority Categories&#39; can be requested from the Department of Infrastructures, Mobility and Transportation within 30 days from the flight date.<br />\\r\\n<br />\\r\\nITA Airways reserves the right to prosecute via the relevant authorities any persons who are not eligible for the discounted fare selected. Please note that our online sales service is free of charge.</p>\\r\\n\",\"flightmanager.config.holiday.originAirportListCH\":\"GVA,ZRH,BSL,BRN\",\"flightmanager.flight.tripType.multicity.label\":\"Mehrere Strecken / Gabelfl\u00fcge\",\"flightmanager.holiday.templates.childrenAgeListTemplate\":\"{YEARS, plural, =-1 {-} =0 {<2 years} other {{YEARS} Jahre}}\",\"flightmanager.flight.od.invalidPaxNumber\":\"Die Anzahl der Passagiere ist f\u00fcr den ausgew\u00e4hlten Zugangscode unzul\u00e4ssig.\",\"flightmanager.config.holiday.trackingParameterUTMCampaign\":\"Galery{COUNTRY_CODE}\",\"flightmanager.flight.travelDetails.farePreferenceHidden\":\"Die Option zur Tarifauswahl wird nicht mehr angezeigt.\",\"flightmanager.common.default.moduleName\":\"Flugsuche\",\"flightmanager.flight.od.destinationCodeErrorNot\":\"Abflug- und Zielflughafen sind identisch. Bitte \u00fcberpr\u00fcfen Sie Ihre Angaben und wiederholen Sie die Anfrage.\",\"flightmanager.flight.travelDetails.adultsErrorMinTotalAdults\":\"Bitte erh\u00f6hen Sie die Anzahl der Erwachsenen.\",\"flightmanager.flight.territorialContinuity.pleaseNoteContentSardinia\":\"In a single online transaction, it is not possible to purchase flight tickets for passengers who are eligible for reduced fares together with tickets for passengers who are not eligible.\",\"flightmanager.flight.travelDetails.accessCodeFieldVisible\":\"Das Eingabefeld f\u00fcr einen Zugangscode ist verf\u00fcgbar.\",\"flightmanager.promotionTeaser.default.teaserButtonText\":\"Verf\u00fcgbarkeit pr\u00fcfen\",\"flightmanager.flight.button.continue\":\"Weiter\",\"flightmanager.flight.stopover.stopoverSelectedAnnouncement\":\"Stopover wurde ausgew\u00e4hlt \u2013 zus\u00e4tzliche Eingabefelder sind jetzt verf\u00fcgbar.\\r\\n\",\"flightmanager.flight.territorialContinuity.modalHeadlineSicily\":\"The selected route includes flights discounted for Sicilian residents\",\"flightmanager.flight.useMiles.cashAndMilesButtonLoginSR\":\"Klicken Sie auf den Button, um zum Login-Bereich zu gelangen.\",\"flightmanager.flight.territorialContinuity.sicilyNotificationText\":\"Decree of the Director General of the Sicilian Department of Infrastructure, Mobility and Transport No. 3158 of 10 November 2023\",\"flightmanager.holiday.checkOutDate.errorRequired\":\"Bitte geben Sie Ihr R\u00fcckflugdatum ein.\",\"flightmanager.flight.travelDetails.cugDropdownLabel\":\"Zugangscode\",\"flightmanager.car.searchButton.default\":\"Mietwagen suchen\",\"flightmanager.flight.territorialContinuity.disabledDescription\":\"Civil disability with a percentage at least equal to or greater than 80% certified by a report issued by the medical commission showing the percentage of disability\",\"flightmanager.flight.territorialContinuity.modalHeadlineSardiniaSecondStep\":\"What category do all the passengers you are booking for belong to?\",\"flightmanager.config.territorialContinuity.milToPmoDates\":\"/2026-07-31\",\"flightmanager.flight.travelDetails.groupBookingLinkText\":\"Gruppenbuchungen f\u00fcr zehn oder mehr Passagiere.\",\"flightmanager.flight.travelDetails.invalidCugSelection\":\"Der ausgew\u00e4hlte Zugangscode ist nicht g\u00fcltig.\",\"flightmanager.config.holiday.originAirportListAT\":\"VIE,INN,SZG,GRZ,LNZ\",\"flightmanager.flight.territorialContinuity.winterWorkerStepperHint\":\"non-residents traveling to Sardinia for work\",\"flightmanager.config.territorialContinuity.sardiniaWinterSeasonDates\":\"26.10-28.03\",\"flightmanager.flight.territorialContinuity.seniorsStepperLabel\":\"Seniors\",\"flightmanager.flight.territorialContinuity.studentsUnderDescription\":\"<p>In addition to a valid ID document certifying actual residence in Friuli-Venezia Giulia:<br />\\r\\n<br />\\r\\nfor university students: the Student&#39;s valid record-book. If the record-book does not display an expiry date, then it is necessary to present the certificate of enrolment of the university for the current year;<br />\\r\\n<br />\\r\\nfor students of primary and secondary schools: a suitable document certifying registration</p>\\r\\n\",\"flightmanager.promotionTeaser.default.fillSrInfo\":\"Flight origing and destination has been filled with {ORIGIN} and {DESTINATION}\",\"flightmanager.car.category.label\":\"Fahrzeugklasse\",\"flightmanager.flight.dateInputGrouped.dateInvalid\":\"Bitte geben Sie ein g\u00fcltiges Reisedatum ein.\",\"flightmanager.flight.territorialContinuity.studentsStepperLabel\":\"Students\",\"flightmanager.flight.territorialContinuity.universityStudentsDescription\":\"<p>Valid university student&#39;s records book.<br />\\r\\nIf the student&#39;s records book does not have an expiration date, you must instead provide a certificate of enrollment for the current academic year</p>\\r\\n\",\"flightmanager.flight.travelDetails.farePreferenceApplied\":\"Der ausgew\u00e4hlte Tarif wurde \u00fcbernommen.\",\"flightmanager.config.flight.youngAdultEligibleAirports\":\"LON,LHR,LCY,LGW,MAN,BHX,LPL,STN,LTN,EMA,EDI,GLA,BRS,NCL,ABZ,SOU,JER\",\"flightmanager.flight.stopover.stopoverSectionHidden\":\"Die Stopover-Option ist nicht mehr sichtbar.\",\"flightmanager.flight.swapButton.clicked\":\"Sie haben Ihren Abflugs- und Zielort getauscht.\",\"flightmanager.holiday.templates.durationWeekTemplate\":\"{WEEKS, plural, one {{WEEKS, number} Woche} other {{WEEKS, number} Wochen}}\",\"flightmanager.flight.od.datesNotInSequence\":\"Sie haben ein R\u00fcckflugdatum gew\u00e4hlt, das vor dem Abflugdatum liegt.\",\"flightmanager.flight.stopover.nightsNumber\":\"Wie viele N\u00e4chte?\",\"flightmanager.flight.travelDetails.travellersNumberHeadline\":\"Number of travellers\",\"flightmanager.config.flight.isBusinessDefaultLabel\":\"Y\",\"flightmanager.flight.territorialContinuity.infantsStepperLabel\":\"Infants\",\"flightmanager.holiday.traveller.child1AgeLabel\":\"Alter Kind 1\",\"flightmanager.flight.travelDetails.maxPaxErrorWithLinkSrInfo\":\"Bitte klicken Sie auf diesen Link, um Flugbuchungen f\u00fcr Gruppen \u00fcber 9 Personen vorzunehmen.\",\"flightmanager.flight.multicity.srFlightAddedMessage\":\"Flugsegment {INDEX} hinzugef\u00fcgt.\",\"flightmanager.destinationTeaser.default.teaserLink\":\"Daten ausw\u00e4hlen\",\"flightmanager.flight.links.whereWeFlyLabel\":\"Entdecken Sie unsere Reiseziele.\",\"flightmanager.car.dropoff.maxDifferenceDays\":\"Das Anmietdatum liegt zu weit in der Zukunft\",\"flightmanager.flight.travelDetails.maxPaxErrorWithLink\":\"Bitte klicken Sie auf diesen Link, um Flugbuchungen f\u00fcr Gruppen \u00fcber 9 Personen vorzunehmen.\\r\\n\",\"flightmanager.stopover.default.stopoverLink\":\"\",\"flightmanager.flight.dateInputGrouped.datePickerIcon\":\"Datum ausw\u00e4hlen\",\"flightmanager.flight.stopover.descriptionSView\":\"Verl\u00e4ngern Sie Ihren Aufenthalt  \u2013 entdecken Sie M\u00fcnchens Vielfalt und Umgebung. Profitieren Sie von exklusiven Partnerangeboten nur f\u00fcr Stopover-G\u00e4ste.\",\"flightmanager.holiday.traveller.child2AgeHint\":\"Bitte w\u00e4hlen Sie das Alter des Kindes aus.\",\"flightmanager.flight.territorialContinuity.typesOfPassengersNamesHeadline\":\"Residents, Young people, Elderly\",\"flightmanager.config.flight.isB2PrefetchEnabled\":\"Y\",\"flightmanager.flight.travelDetails.infantsWithSeatAwardRestriction\":\"Leider k\u00f6nnen Pr\u00e4mienbuchungen nicht mit Kleinkinder mit Sitzplatz kombiniert werden.\",\"flightmanager.flight.links.accessCode\":\"Ich habe einen Zugangscode\",\"flightmanager.flight.travelDetails.primaryButtonText\":\"Weiter\",\"flightmanager.config.holiday.swissHolidaysTargetUrl\":\"https://www.swissholidays.com\",\"flightmanager.car.dropoff.timeRequired\":\"Bitte w\u00e4hlen Sie eine Uhrzeit aus.\",\"flightmanager.flight.travelDetails.cugDropdownHint\":\"Bitte w\u00e4hlen Sie einen Zugangscode aus.\",\"flightmanager.config.holiday.originAirportListDE\":\"TXL,BRE,DTM,DRS,DUS,FRA,FDH,HAM,HAJ,FKB,CGN,LEJ,MUC,FMO,NUE,PAD,STR,-,SZG,VIE,GRZ,LNZ\",\"flightmanager.car.dropoff.minimumDate\":\"The return date should be after the rental date.\",\"flightmanager.flight.od.userNotLoggedIn\":\"Bitte melden Sie sich an, um den ausgew\u00e4hlten Zugangscode zu verwenden.\",\"flightmanager.flight.stopover.description\":\"Verl\u00e4ngern Sie Ihren Aufenthalt \u2013 entdecken Sie M\u00fcnchens Vielfalt und Umgebung. \\r\\nProfitieren Sie von exklusiven Partnerangeboten nur f\u00fcr Stopover-G\u00e4ste: von Hotelaufenthalten und Sehensw\u00fcrdigkeiten bis hin zu F\u00fchrungen und Shopping-Vorteilen.\",\"flightmanager.flight.links.multistopbuttonLabel\":\"Mehrere Strecken / Gabelfl\u00fcge\",\"flightmanager.hotel.cityName.hint\":\"\",\"flightm