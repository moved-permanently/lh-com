r.default.teaserInfo\":\"{DESTINATION} - prices from {PRICE} {CURRENCYSYMBOL}\",\"flightmanager.flight.territorialContinuity.faresInfoParagraphTrieste\":\"The fares for these flights will be differentiated based on whether or not they belong to the following categories of passengers (without any discrimination related to place of birth or nationality):\",\"flightmanager.flight.useMiles.registerLink\":\"Become a member\",\"flightmanager.flight.travelDetails.accessCodeApplied\":\"Your access code was applied.\",\"flightmanager.car.category.hint\":\"\",\"flightmanager.flight.territorialContinuity.importantHeadline\":\"Important\",\"flightmanager.holiday.traveller.adults\":\"Number of adults\",\"flightmanager.flight.travelDetails.personalTravelChosenSR\":\"There are additional fare options available for your trip.\",\"flightmanager.config.holiday.durationsList\":\"-1,7,14,21,1-3,2-3,3-5,5-7,7-12,10-14,1,2,3,4,5,6,8,9,10,11,12,13,15\",\"flightmanager.car.dropoff.locationRequired\":\"Please enter your drop-off location.\",\"flightmanager.hotel.checkin.hint\":\"\",\"flightmanager.destinationTeaser.default.destination\":\"{DESTINATION}\",\"flightmanager.flight.useMiles.registerLinkSR\":\"Click the button to sign up.\",\"flightmanager.flight.useMiles.awardFlowTitle\":\"Miles & More Award Booking\",\"flightmanager.flight.links.voucherCode\":\"I have a voucher code.\",\"flightmanager.common.default.studentStatusVerificationButtonSrInfo\":\"On click, this button will open a modal with form provided by SheerID allowing for student status verification\",\"flightmanager.flight.useMiles.flightAwardsButton\":\"Search award flights\",\"flightmanager.flight.stopover.add\":\"Add Stopover in Munich\",\"flightmanager.hotel.checkout.afterCheckin\":\"Check-Out has to be after Check-In.\",\"flightmanager.flight.territorialContinuity.sicilyResidentsSectionContent\":\"At the time of making the online purchase of the ticket, it will be necessary to enter the details of the traveler\u2019s document or residence permit for European citizens and the Municipality of Residence so as to prove eligibility and demonstrate to the airline, by means of self-declaration, his or her status <strong>as a Sicilian resident.</strong><br>\\r\\n\",\"flightmanager.flight.useMiles.cashAndMilesHeadline\":\"Cash & Miles\",\"flightmanager.car.dropoff.locationHint\":\"\",\"flightmanager.flight.od.destinationCodeErrorRequired\":\"Please enter your destination and try again.\",\"flightmanager.flight.territorialContinuity.sicilyImportantInfoPaymentForms\":\"The discount cannot be combined with other forms of payment such as gift cards or discount codes\",\"flightmanager.car.pickup.timeRequired\":\"Please enter your pick-up time.\",\"flightmanager.flight.accessCode.hint\":\"This field is for access codes only. If you have a promotional code, please enter it on the payment page.\",\"flightmanager.holiday.traveller.childrenGroup\":\"Travel with children\",\"flightmanager.flight.territorialContinuity.winterWorker\":\"Worker (only on winter season)\",\"flightmanager.flight.useMiles.awardFlowBookingForOtherPerson\":\"I'm booking for someone else and not flying myself.\",\"flightmanager.flight.travelDetails.dismissedPrefix\":\"Dismissed:\",\"flightmanager.flight.travelDetails.openButtonInfo\":\"{CABIN}, {TRAVELLERS_COUNT, plural, =0 {} one {1 {TRAVELLER}} other {{TRAVELLERS_COUNT} {TRAVELLERS}}}{ACCESS_CODE_APPLIED}{CUG_CODE_APPLIED}{FARE_PREFERENCE_APPLIED}\",\"flightmanager.flight.useMiles.headline\":\"Choose from two ways to use your miles.\",\"flightmanager.flight.links.whereWeFlyHref\":\"https://www.lufthansa.com/xx/en/flights\",\"flightmanager.promotionTeaser.default.fallbackButtonLabel\":\"Check best prices\",\"flightmanager.flight.territorialContinuity.childrenStepperLabel\":\"Children\",\"flightmanager.flight.oneway.label\":\"One-way\",\"flightmanager.flight.territorialContinuity.notificationTextTrieste\":\"Decree of the Italian Ministry of Infrastructure and Transport No. 96 of 12 April 2023\",\"flightmanager.config.holiday.lufthansaHolidaysTargetUrl\":\"https://www.lufthansaholidays.com\",\"flightmanager.flight.travelDetails.youthsLabel\":\"Youth\",\"flightmanager.flight.stopover.selectArrivalOption\":\"Arrival\",\"flightmanager.flight.territorialContinuity.sicilyDiscountDisabledNotificationText\":\"Sorry, the discount for Sicily residents is no longer available. Please continue with a normal booking\",\"flightmanager.flight.territorialContinuity.nonResidentsTravelingDescription\":\"For non-residents traveling to Sardinia for work reasons during the IATA winter season (from 27 October 2024 to 29 March 2025), in order to access this fare, the documentation with which the employer certifies the transfer of the employee or, in the case of freelancers, a self-certification and the presentation of the card of the professional. The form must be printed, completed and presented at boarding, accompanied by a valid identity document.<br>\\r\\n\",\"flightmanager.flight.useMiles.tabName\":\"Redeem miles\",\"flightmanager.flight.autosuggest.recentSearches\":\"Recent searches\",\"flightmanager.flight.territorialContinuity.pleaseNoteHeadline\":\"Please note\",\"flightmanager.flight.territorialContinuity.pleaseNoteContentTrieste\":\"<p>It is not possible to purchase, in a single web transaction, airline tickets for passengers who meet the requirements for discounted fares together with those for passengers who do not meet these requirements.<br />\\r\\n<br />\\r\\nMoreover, it is not possible to merge multiple passenger types into one reservation (you will need to make different reservations).</p>\\r\\n\",\"flightmanager.flight.territorialContinuity.youngPeople\":\"Young people (from 2 to 21 years)\",\"flightmanager.flight.travelDetails.concorButtonText\":\"Corporate Travel, {CABIN}\",\"flightmanager.flight.accessCode.mamStatusError\":\"This access code isn\u2019t valid for your Miles & More status.\",\"flightmanager.flight.territorialContinuity.residentsInFriuliDescription\":\"Valid ID document certifying actual residence in Friuli-Venezia Giulia.\",\"flightmanager.car.dropoff.timeLabel\":\"Drop-off time\",\"flightmanager.hotel.checkout.label\":\"Check-out date\",\"flightmanager.flight.od.originCodeErrorRequired\":\"Please enter your origin and try again.\",\"flightmanager.holiday.default.searchButton\":\"Search holiday\",\"flightmanager.config.territorialContinuity.romToCtaDates\":\"/2026-07-31\",\"flightmanager.car.pickup.locationRequired\":\"Please enter your pick-up location.\",\"flightmanager.flight.territorialContinuity.universityStudents\":\"University students (18-26 years)\",\"flightmanager.car.category.errorRequired\":\"Please select your car category.\",\"flightmanager.flight.territorialContinuity.modalHeadlineSardinia\":\"On the selected route, there are flights with territorial continuity fares\",\"flightmanager.flight.territorialContinuity.requestedDocumentsCollapsibleTab\":\"Requested documents for each category section\",\"flightmanager.flight.od.endDateErrorRequired\":\"Please enter your return date and try again.\",\"flightmanager.flight.travelDetails.segmentCodesFetchError\":\"Loading your segment codes failed. Reopen the modal to try again.\",\"flightmanager.flight.stopover.selectDepartureOption\":\"Departure\",\"flightmanager.flight.travelDetails.farePreferenceMedium\":\"Medium\",\"flightmanager.flight.territorialContinuity.seniorResidentsStepperLabel\":\"Residents\",\"flightmanager.flight.od.invalidRoute\":\"The selected route is either not available for the requested dates, cannot be booked online or is not served by our airline.\",\"flightmanager.flight.useMiles.flightAwardsButtonSR\":\"Start your award flight search by clicking the button.\",\"flightmanager.car.pickup.dateRequired\":\"Please enter your pick-up date.\",\"flightmanager.flight.territorialContinuity.disabled\":\"Disabled (no discount for accompanying persons)\",\"flightmanager.flight.travelDetails.cugCodeApplied\":\"Your access code has been applied.\",\"flightmanager.flight.territorialContinuity.studentsStepperHint\":\"University students (18-26 years)\",\"flightmanager.flight.territorialContinuity.youthStepperHint\":\"From 12 to under 14 years of age, either the minor must travel with a responsible adult, or the procedure for unaccompanied minors must be activated via the Contact Center\",\"flightmanager.flight.travelDetails.tripTypeLabel\":\"Type of trip\",\"flightmanager.hotel.checkout.errorRequired\":\"Please enter your departure date.\",\"flightmanager.flight.accessCode.label\":\"Access code\",\"flightmanager.flight.territorialContinuity.paragraphPleaseNote\":\"Please note, it will not be possible to merge multiple passenger types into one reservation (you will need to make different reservations)\",\"flightmanager.flight.territorialContinuity.studentsUnder\":\"Students under 27 years of age (Residents in Friuli-Venezia Giulia)\",\"flightmanager.config.territorialContinuity.milToCtaDates\":\"/2026-07-31\",\"flightmanager.flight.territorialContinuity.notificationTextSardinia\":\"Decree of the Italian Ministry of Sustainable Infrastructure and Mobility (today, Ministry of Infrastructure and Transport) No. 466 of 25 November 2021, and subsequent amendments\",\"flightmanager.flight.calendar.clearOutboundDate.label\":\"Clear Departure Date\",\"flightmanager.flight.useMiles.infantAwardBookingError\":\"Award Flights for infants under 2 years can only be booked via the Miles & More service team. You can book your Award Flights without infant online and contact the service team afterwards with your booking code.\",\"flightmanager.flight.territorialContinuity.importantContentSardinia\":\"<p>At any time, the customer may be asked to produce documentation that confirms they belong to one of the categories indicated above.<br />\\r\\n<br />\\r\\nTo purchase tickets for unaccompanied minor passengers, please refer to the customer center.<br />\\r\\nITA Airways reserves the right to prosecute via the relevant authorities any persons who are not eligible for the discounted fare selected. Please be informed that our online sales service is free of charge.</p>\\r\\n\",\"flightmanager.config.flight.cugSegmentsFetchingUrl\":\"https://api.travelid.lufthansa.com/cug/v1/me/user-group?status=ACTIVE \",\"flightmanager.flight.useMiles.flightAwardsHeadline\":\"Book Award Flights\",\"flightmanager.hotel.default.searchButton\":\"Search hotel\",\"flightmanager.flight.territorialContinuity.sicilyImportantInfoAllowedCards\":\"Payment can only be made by credit/debit card (PayPal, Apple Pay and bank transfers are excluded)\",\"flightmanager.flight.territorialContinuity.winterWorkerStepperLabel\":\"Worker\",\"flightmanager.car.moreLink.default\":\"Search with more options\",\"flightmanager.flight.useMiles.awardFlowDescription\":\"By enabling this option, you can redeem your miles for award flights. Please note that you will be redirected to the Miles & More award booking process.\",\"flightmanager.flight.od.departureDateInPast\":\"Your departure date is in the past. Please select a valid date.\",\"flightmanager.config.flight.b2PrefetchScriptUrl\":\"https://shop.lufthansa.com/booking/api/prefetch\",\"flightmanager.flight.territorialContinuity.sicilyFaresInfoBottomParagraph\":\"<p>It is not possible to purchase, in a single web transaction, airline tickets for passengers who meet the requirements for discounted fares together with those for passengers who do not meet these requirements.<br />\\r\\n<br />\\r\\nMoreover, it is not possible to merge multiple passenger types (residents and non-residents) into one reservation (you will need to make different reservations).<br />\\r\\n<br />\\r\\nPlease note: upon boarding, the customer may be asked to produce documentation confirming they belong to the category indicated above.<br />\\r\\n<br />\\r\\nTickets for <strong>&quot;Priority Categories&quot; can be purchased online at the standard discount</strong> (as indicated in the D.D.G. Director General&#39;s Decree - No. 3158 of 10 November, 2023, from the Department of Infrastructures and Mobility of the Sicily Region - Department of Infrastructures, Mobility and Transportation). The refund of the additional contribution for &#39;Priority Categories&#39; can be requested from the Department of Infrastructures, Mobility and Transportation within 30 days from the flight date.<br />\\r\\n<br />\\r\\nITA Airways reserves the right to prosecute via the relevant authorities any persons who are not eligible for the discounted fare selected. Please note that our online sales service is free of charge.</p>\\r\\n\",\"flightmanager.config.holiday.originAirportListCH\":\"GVA,ZRH,BSL,BRN\",\"flightmanager.flight.tripType.multicity.label\":\"Multi-city\",\"flightmanager.holiday.templates.childrenAgeListTemplate\":\"{YEARS, plural, =-1 {-} =0 {<2 years} other {{YEARS} years}}\",\"flightmanager.flight.od.invalidPaxNumber\":\"The number of passengers is incorrect for the selected access code.\",\"flightmanager.config.holiday.trackingParameterUTMCampaign\":\"Galery{COUNTRY_CODE}\",\"flightmanager.flight.travelDetails.farePreferenceHidden\":\"Fare selection option is no longer visible.\",\"flightmanager.common.default.moduleName\":\"Flight Manager\",\"flightmanager.flight.od.destinationCodeErrorNot\":\"Origin and destination are the same. Please check your input and try again.\",\"flightmanager.flight.travelDetails.adultsErrorMinTotalAdults\":\"Please increase the number of adults.\",\"flightmanager.flight.territorialContinuity.pleaseNoteContentSardinia\":\"In a single online transaction, it is not possible to purchase flight tickets for passengers who are eligible for reduced fares together with tickets for passengers who are not eligible.\",\"flightmanager.flight.travelDetails.accessCodeFieldVisible\":\"Access code field is now available.\",\"flightmanager.promotionTeaser.default.teaserButtonText\":\"Check flights\",\"flightmanager.flight.button.continue\":\"Continue\",\"flightmanager.flight.stopover.stopoverSelectedAnnouncement\":\"Stopover was selected, additional inputs are now available\",\"flightmanager.flight.territorialContinuity.modalHeadlineSicily\":\"The selected route includes flights discounted for Sicilian residents\",\"flightmanager.flight.useMiles.cashAndMilesButtonLoginSR\":\"Click the button to proceed to login.\",\"flightmanager.flight.territorialContinuity.sicilyNotificationText\":\"Decree of the Director General of the Sicilian Department of Infrastructure, Mobility and Transport No. 3158 of 10 November 2023\",\"flightmanager.holiday.checkOutDate.errorRequired\":\"Please enter your departure date.\",\"flightmanager.flight.travelDetails.cugDropdownLabel\":\"Access code\",\"flightmanager.car.searchButton.default\":\"Search rental car\",\"flightmanager.flight.territorialContinuity.disabledDescription\":\"Civil disability with a percentage at least equal to or greater than 80% certified by a report issued by the medical commission showing the percentage of disability\",\"flightmanager.flight.territorialContinuity.modalHeadlineSardiniaSecondStep\":\"What category do all the passengers you are booking for belong to?\",\"flightmanager.config.territorialContinuity.milToPmoDates\":\"/2026-07-31\",\"flightmanager.flight.travelDetails.groupBookingLinkText\":\"Group bookings for 10 or more passengers.\",\"flightmanager.flight.travelDetails.invalidCugSelection\":\"The selected access code is not valid.\",\"flightmanager.config.holiday.originAirportListAT\":\"VIE,INN,SZG,GRZ,LNZ\",\"flightmanager.flight.territorialContinuity.winterWorkerStepperHint\":\"non-residents traveling to Sardinia for work\",\"flightmanager.config.territorialContinuity.sardiniaWinterSeasonDates\":\"26.10-28.03\",\"flightmanager.flight.territorialContinuity.seniorsStepperLabel\":\"Seniors\",\"flightmanager.flight.territorialContinuity.studentsUnderDescription\":\"<p>In addition to a valid ID document certifying actual residence in Friuli-Venezia Giulia:<br />\\r\\n<br />\\r\\nfor university students: the Student&#39;s valid record-book. If the record-book does not display an expiry date, then it is necessary to present the certificate of enrolment of the university for the current year;<br />\\r\\n<br />\\r\\nfor students of primary and secondary schools: a suitable document certifying registration</p>\\r\\n\",\"flightmanager.promotionTeaser.default.fillSrInfo\":\"Flight origing and destination has been filled with {ORIGIN} and {DESTINATION}\",\"flightmanager.car.category.label\":\"Car category\",\"flightmanager.flight.dateInputGrouped.dateInvalid\":\"Please enter a valid travel date\",\"flightmanager.flight.territorialContinuity.studentsStepperLabel\":\"Students\",\"flightmanager.flight.territorialContinuity.universityStudentsDescription\":\"<p>Valid university student&#39;s records book.<br />\\r\\nIf the student&#39;s records book does not have an expiration date, you must instead provide a certificate of enrollment for the current academic year</p>\\r\\n\",\"flightmanager.flight.travelDetails.farePreferenceApplied\":\"Your fare selection is active.\",\"flightmanager.config.flight.youngAdultEligibleAirports\":\"LON,LHR,LCY,LGW,MAN,BHX,LPL,STN,LTN,EMA,EDI,GLA,BRS,NCL,ABZ,SOU,JER\",\"flightmanager.flight.stopover.stopoverSectionHidden\":\"Stopover section was hidden\",\"flightmanager.flight.swapButton.clicked\":\"You have switched your origin and destination.\",\"flightmanager.holiday.templates.durationWeekTemplate\":\"{WEEKS, plural, one {{WEEKS, number} week} other {{WEEKS, number} weeks}}\",\"flightmanager.flight.od.datesNotInSequence\":\"Your departure date is before the previous flight date.\",\"flightmanager.flight.stopover.nightsNumber\":\"How many nights?\",\"flightmanager.flight.travelDetails.travellersNumberHeadline\":\"Number of travellers\",\"flightmanager.config.flight.isBusinessDefaultLabel\":\"Y\",\"flightmanager.flight.territorialContinuity.infantsStepperLabel\":\"Infants\",\"flightmanager.holiday.traveller.child1AgeLabel\":\"Age of 1st child\",\"flightmanager.flight.travelDetails.maxPaxErrorWithLinkSrInfo\":\"Please click this link to make flight bookings for groups of more than 9 people.\",\"flightmanager.flight.multicity.srFlightAddedMessage\":\"Flight segment {INDEX} added\",\"flightmanager.destinationTeaser.default.teaserLink\":\"Select dates\",\"flightmanager.flight.links.whereWeFlyLabel\":\"Explore our destinations.\",\"flightmanager.car.dropoff.maxDifferenceDays\":\"The selected date must be in the future and the drop-off date must occur after the pick-up date.\",\"flightmanager.flight.travelDetails.maxPaxErrorWithLink\":\"Please click this link to make flight bookings for groups of more than 9 people.\",\"flightmanager.stopover.default.stopoverLink\":\"http://www.stopover-switzerland.com/en\",\"flightmanager.flight.dateInputGrouped.datePickerIcon\":\"Select date\",\"flightmanager.flight.stopover.descriptionSView\":\"Make the most of your layover \u2014 explore Munich\u2019s vibrant heart and its surroundings.\\r\\nEnjoy selected partner offers available only to Stopover guests.\",\"flightmanager.holiday.traveller.child2AgeHint\":\"Please enter age of child\",\"flightmanager.flight.territorialContinuity.typesOfPassengersNamesHeadline\":\"Residents, Young people, Elderly\",\"flightmanager.config.flight.isB2PrefetchEnabled\":\"Y\",\"flightmanager.flight.travelDetails.infantsWithSeatAwardRestriction\":\"Infants with seat cannot be requested for an Award Booking flow.\",\"flightmanager.flight.links.accessCode\":\"I have an access code\",\"flightmanager.flight.travelDetails.primaryButtonText\":\"Continue\",\"flightmanager.config.holiday.swissHolidaysTargetUrl\":\"https://www.swissholidays.com\",\"flightmanager.car.dropoff.timeRequired\":\"Please enter your drop-off time.\",\"flightmanager.flight.travelDetails.cugDropdownHint\":\"Please select your access code.\",\"flightmanager.config.holiday.originAirportListDE\":\"TXL,BRE,DTM,DRS,DUS,FRA,FDH,HAM,HAJ,FKB,CGN,LEJ,MUC,FMO,NUE,PAD,STR,-,SZG,VIE,GRZ,LNZ\",\"flightmanager.car.dropoff.minimumDate\":\"The return date should be after the rental date.\",\"flightmanager.flight.od.userNotLoggedIn\":\"Your login is required to use the selected access code.\",\"flightmanager.flight.stopover.description\":\"Make the most of your layover \u2014 explore Munich\u2019s vibrant heart and its surroundings.\\r\\nEnjoy selected partner offers available only to Stopover guests from hotel stays and iconic sights to guided tours and shopping perks.\",\"flightmanager.flight.links.multistopbuttonLabel\":\"Multi-city flights\",\"flightmanager.hotel.cityName.hint\":\"\",\"flightmanager.car.dropoff.locationLabel\":\"Drop-off location\",\"flightmanager.flight.territorialContinuity.modalHeadlineSardiniaFirstStep\":\"On the selected route, there are flights with territorial continuity fares\",\"flightmanager.flight.dateInputGrouped.oneWayTripDate\":\"{DEPARTURE}\",\"flightmanager.flight.useMiles.cashAndMilesButtonLogin\":\"Continue with login\",\"flightmanager.flight.territorialContinuity.seniorResidents\":\"Passengers over 65 travelling for health reasons (Residents in Friuli-Venezia Giulia)\",\"flightmanager.flight.territorialContinuity.sicilyFaresInfoTopParagraph\":\"<p>The discount provides for a reduction in the price of air tickets for the benefit of passengers <strong>residing in the Italian region of Sicily.</strong><br />\\r\\n<br />\\r\\nThe fares of these flights, therefore, will depend on a self-declaration of residence or otherwise in Sicily and membership or otherwise in the Priority Categories defined in D.D.G. No. 3158 of 10 November 2023: i) residents with a disability level of 67% and above, ii) students, or iii) low-income residents (ISEE &lt; &euro; 9,360.00).</p>\\r\\n\",\"flightmanager.hotel.checkout.errorType\":\"Please enter your departure date.\",\"flightmanager.flight.tripType.roundtrip.label\":\"Round trip\",\"flightmanager.stopover.default.tab\":\"Stopover\",\"flightmanager.flight.oneway.selected\":\"Trip type has been changed to one-way, so return date field is no longer applicable.\",\"flightmanager.flight.searchButton.default\":\"Find flights\"}"}, "redirectURL": "", "headersSize": -1, "bodySize": -1}, "cache": {}, "timings": {"send": 0, "wait": 0, "receive": 0}}, {"startedDateTime": "2026-10-21T18:26:57.084Z", "time": 0, "request": {"method": "GET", "url": "https://www.lufthansa.com/service/api/lhg-fare-teaser/fareteaser/recommend", "httpVersion": "HTTP/2", "headers": [{"name": "Referer", "value": "https://www.lufthansa.com/gb/en/homepage"}, {"name": "X-Portal-Site", "value": "GB"}, {"name": "X-Portal-Language", "value": "en"}, {"name": "X-Portal", "value": "LH"}, {"name": "X-Portal-Taxonomy", "value": ""}, {"name": "X-Portal-CountryId", "value": ""}, {"name": "line", "value": "b"}], "queryString": [], "cookies": [], "headersSize": -1, "bodySize": 0}, "response": {"status": 200, "statusText": "", "httpVersion": "HTTP/2", "headers": [], "cookies": [], "content": {"size": 1174, "mimeType": "application/json", "text": "{\"fareTeaserRecommends\":[{\"airportCodes\":[\"BHD\",\"BFS\"],\"cityName\":\"Belfast City\",\"cityNameUrl\":\"belfast+city\",\"origin\":\"BFS\"},{\"airportCodes\":[\"ZBC\",\"BHX\"],\"cityName\":\"Birmingham, GB\",\"cityNameUrl\":\"birmingham_+gb\",\"origin\":\"BHX\"},{\"airportCodes\":[\"BRS\",\"BPR\",\"TPB\"],\"cityName\":\"Bristol\",\"cityNameUrl\":\"bristol\",\"origin\":\"BRS\"},{\"airportCodes\":[\"EDI\",\"ZXE\"],\"cityName\":\"Edinburgh\",\"cityNameUrl\":\"edinburgh\",\"origin\":\"EDI\"},{\"airportCodes\":[\"GLA\",\"PIK\"],\"cityName\":\"Glasgow\",\"cityNameUrl\":\"glasgow\",\"origin\":\"GLA\"},{\"airportCodes\":[\"INV\",\"ZIV\"],\"cityName\":\"Inverness\",\"cityNameUrl\":\"inverness\",\"origin\":\"INV\"},{\"airportCodes\":[\"JER\"],\"cityName\":\"Jersey\",\"cityNameUrl\":\"jersey\",\"origin\":\"JER\"},{\"airportCodes\":[\"LPL\"],\"cityName\":\"Liverpool\",\"cityNameUrl\":\"liverpool\",\"origin\"