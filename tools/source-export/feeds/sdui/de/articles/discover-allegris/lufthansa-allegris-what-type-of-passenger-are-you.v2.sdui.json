     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/de/articles/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you/jcr:content/articlecontentfragment/par3/separator_copy_copy__1719339462"
     },
     {
      "type": "copyText",
      "text": "Die Fashion-Designerin&nbsp;",
      "size": "MEDIUM",
      "variant": "HEADLINE",
      "id": "/lh/de/mobile-app/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "Für sie ist jeder Gang ein Laufsteg – und jeder Flug eine Inspirationsquelle. Im Extra Space Seat der Business Class wird die großzügige Ablagefläche kurzerhand zum Atelier, während Sichtschutz sowie Sitzheizung und -kühlung für ungestörte Kreativität und maximalen Komfort sorgen. Die nächste Kollektion landet oft noch vor dem Flugzeug.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you_paragraph_5"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you/jcr:content/articlecontentfragment/par5/image_copy_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you/lh_app_allegris_fashion-designer_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Frau mit Brille sitzt zwischen anderen Passagier:innen in der Lufthansa Allegris Business Class und spricht mit einem Flugbegleiter."
     },
     {
      "type": "copyText",
      "text": "Das Power Couple&nbsp;",
      "size": "MEDIUM",
      "variant": "HEADLINE",
      "id": "/lh/de/mobile-app/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "Sie glauben, sie hätten schon alles gesehen? Vielleicht. Aber die First Class Suite Plus setzt noch einen drauf. Abendessen wie im Sternerestaurant, später das Doppelbett genießen und den Filmabend vor dem 43-Zoll-Bildschirm verbringen – da darf der Landeanflug ruhig noch ein bisschen auf sich warten lassen.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you_paragraph_7"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you/jcr:content/articlecontentfragment/par7/image_copy_copy_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/discover-allegris/lufthansa-allegris-what-type-of-passenger-are-you/lh_app_allegris_power-couple_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Weibliches Paar, das sich an einem gedeckten Tisch in der Lufthansa Allegris First Class gegenübersitzt und isst."
     }
    ],
