      "id": "/content/mobile/lh/de/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par10/separator"
     },
     {
      "type": "copyText",
      "text": "<b>Nachmittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_11"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par11/image_copy_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/south-america/a-perfect-day-in-buenos-aires/lh_app_buenos-aires_la-boca_getty172800353_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Blick auf bunt gestrichene Wellblechhäuser im Viertel La Boca in Buenos Aires."
     },
     {
      "type": "copyText",
      "text": "<b>Spaziergang durch La Boca</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_12"
     },
     {
      "type": "copyText",
      "text": "<ul><li>La Boca begeistert mit seinen bunten Häusern, Straßenkünstler:innen und lebendiger Atmosphäre</li><li>Fußballfans sollten einen Blick auf das berühmte Stadion La Bombonera werfen</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_13"
     },
     {
      "type": "copyText",
      "text": "La Bombonera, Brandsen 805, La Boca",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_14"
     },
     {
      "type": "copyText",
      "text": "<b>Abend</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_15"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par15/image_copy_copy_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/south-america/a-perfect-day-in-buenos-aires/lh_app_buenos-aires_palermo_p7e8rp_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Blick auf den Platz Plaza Italia im Viertel Palermo in Buenos Aires."
     },
     {
      "type": "copyText",
      "text": "<b>Dinner im Lo de Jesús</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_16"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Mein Lieblingsrestaurant in Palermo ist das Lo de Jesús</li><li>Meine Empfehlung: Provolone vom Grill mit cremigem Spinat – auch für Vegetarier:innen ein Genuss</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_17"
     },
     {
      "type": "copyText",
      "text": "Lo de Jesús, Gurruchaga 1406, Palermo",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_18"
     },
     {
      "type": "copyText",
      "text": "<b>Cocktails im Milión</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_19"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Den Abend lasse ich am liebsten im Milión ausklingen: Die stilvolle Bar in einer restaurierten Belle-Époque-Villa ist der perfekte Ort für einen Cocktail oder Mocktail</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_20"
     },
     {
      "type": "copyText",
      "text": "Milión, Paraná 1048, Recoleta",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_21"
     },
     {
      "type": "copyText",
      "text": "Bildrechte:&nbsp;Andrea Leopardi / Unsplash, Alamy Stock Photo, Getty Images (2), Juan Pablo Mascanfroni / Unsplash",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_22"
     },
     {
      "type": "copyText",
      "text": "<b>Zur Person</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_23"
     },
     {
      "type": "copyText",
      "text": "Julia Buth begann 2008 als Flugbegleiterin bei Lufthansa und ist seit 2023 als Purser auf Lang- und Kurzstreckenflügen tätig.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_24"
     }
