     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par10/separator_copy_copy__1134327087"
     },
     {
      "type": "copyText",
      "text": "<b>Nachmittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_11"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par11/image_2090881660",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-cape-town/lh_app_capetown_beach_getty671269788_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Weißer Sandstrand mit türkisblauem Wasser"
     },
     {
      "type": "copyText",
      "text": "<b>Panoramafahrt entlang der Atlantikküste</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_12"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Die Strecke über Camps Bay und den Chapman's Peak Drive zählt zu den schönsten Küstenstraßen der Welt</li><li>Mein Tipp: am Noordhoek Beach eine Pause einlegen und den endlosen Sandstrand genießen</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_13"
     },
     {
      "type": "copyText",
      "text": "Noordhoek Beach, Beach Rd, Noordhoek",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_14"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par14/image",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-cape-town/lh_app_capetown_vineyards_getty1292647913_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Vines in the South African landscape"
     },
     {
      "type": "copyText",
      "text": "<b>Weinverkostung bei Buitenverwachting</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_15"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Ein Besuch im Weingut Buitenverwachting im Constantia Valley gehört für mich zu jedem Kapstadt-Aufenthalt</li><li>Die ausgezeichneten Weine machen ihrem Namen alle Ehre</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_16"
     },
     {
      "type": "copyText",
      "text": "Buitenverwachting, Klein Constantia Rd, Constantia",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_17"
     },
     {
      "type": "copyText",
      "text": "<b>Abend</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_18"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par18/image",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-cape-town/lh_app_capetown_beach_getty1202000618_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Sunset at Glen Beach with the Twelve Apostles mountain range in the background"
     },
     {
      "type": "copyText",
      "text": "<b>Sonnenuntergang am Glen Beach</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_19"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Den Sonnenuntergang genieße ich am liebsten am ruhigen Glen Beach</li><li>Ein perfekter Ort, um den Tag entspannt ausklingen zu lassen</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_20"
     },
     {
      "type": "copyText",
      "text": "Glen Beach, Glen Beach, Camps Bay",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_21"
     },
     {
      "type": "copyText",
      "text": "<b>Dinner im Butcher Shop &amp; Grill</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_22"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par22/image",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-cape-town/lh_app_capetown_steak_butcher-shop-and-grill_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Close-up of a plate with a steak"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Zum Abschluss gönne ich mir ein südafrikanisches Steak im Butcher Shop &amp; Grill</li><li>Mein Tipp: das Steak maximal medium bestellen – so schmeckt es am besten</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_23"
     },
     {
      "type": "copyText",
      "text": "Butcher Shop &amp; Grill, 125 Beach Rd, Mouille Point",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_24"
     },
     {
      "type": "copyText",
      "text": "Bildrechte: Imago, Kanéla Café, Getty Images (3), Butcher Shop &amp; Grill",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_25"
     },
     {
      "type": "copyText",
      "text": "<b>Zur Person</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_26"
     },
     {
      "type": "copyText",
      "text": "Purser Till Nawrath arbeitet seit 2016&nbsp; bei Lufthansa. Seine Freizeit verbringt er gern im Ausland – am liebsten in der „Mother City“ Kapstadt.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_27"
     }
    ],
