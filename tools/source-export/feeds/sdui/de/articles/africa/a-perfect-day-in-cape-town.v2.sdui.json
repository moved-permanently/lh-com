    "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town",
    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Kapstadt",
      "variant": "HEADING_XL",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 2 min read | Till Nawrath</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_info"
     },
     {
      "type": "copyText",
      "text": "<b>Purser Till Nawrath ist ein echter Kenner von Kapstadt. In diesem Beitrag teilt er mit uns, welche Elemente für einen perfekten Tag am Fuße des Tafelbergs für ihn unverzichtbar sind.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Vormittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-cape-town/lh_app_capetown_kanela-cafe_image00020_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Tasse mit Kaffee und Milchschaum mit Herz"
     },
     {
      "type": "copyText",
      "text": "<b>Kaffee im Ground Art Caffè</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Mein Tag beginnt mit einem Flat White im Ground Art Caffè im Viertel De Waterkant</li><li>Das stilvolle Café ist der perfekte Ort für einen entspannten Start in den Tag</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "Ground Art Caffè, 160 Strand St, De Waterkant",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Wanderung auf den Lion's Head</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Am Morgen lohnt sich der Aufstieg auf den Lion's Head</li><li>Oben erwartet mich einer der schönsten Ausblicke auf Kapstadt, den Tafelberg und den Ozean</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "Lion's Head, Signal Hill",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "<b>Mittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_7"
     },
     {
      "type": "copyText",
      "text": "<b>Lunch im Kanéla Café</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_8"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Nach der Wanderung gönne ich mir einen Avocado-Toast im Kanéla Café.</li><li>Am liebsten sitze ich im sonnigen Innenhof am Springbrunnen.</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_9"
     },
     {
      "type": "copyText",
      "text": "Kanéla Café, 78 Regent Rd, Sea Point",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_10"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par10/separator_copy_copy_"
