    "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day",
    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Johannesburg",
      "variant": "HEADING_XL",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 2 min read | Farah Benkassem</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_info"
     },
     {
      "type": "copyText",
      "text": "<b>Flugbegleiterin Farah Benkassem verbringt regelmäßig Zeit in Johannesburg und verrät die besten Tipps für einen entspannten Tag in der südafrikanischen Metropole.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Vormittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-johannesburg-in-one-day/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-johannesburg/lh_app_johannesburg_tashacafeb_breakfast_image-18_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Frühstücksteller mit Obst, Joghurt und Müsli"
     },
     {
      "type": "copyText",
      "text": "<b>Frühstück bei Tashas</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Mein Tag beginnt immer mit einem entspannten Frühstück im Tashas im Geschäftsviertel Melrose Arch</li><li>Besonders zu empfehlen sind der Avocado-Milchshake und der Hummus-Avocado-Toast</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "Tashas Melrose Arch, The Piazza, 14 Whiteley Rd, Melrose",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Mittags</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_4"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/africa/a-perfect-day-johannesburg-in-one-day/jcr:content/articlecontentfragment/par4/image",
      "url": "https://www.lufthansa.com/content/dam/lh/de/article-images/mobile-app/africa/perfect-day-johannesburg/lh_app_johannesburg_rosebank_gettyimages1208969350_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Rosebank-Viertel in Johannesburg"
     },
     {
      "type": "copyText",
      "text": "<b>Shopping in Rosebank</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Im Viertel Rosebank laden moderne Shoppingmalls und Galerien zum Bummeln ein</li><li>Mein Tipp: der Art &amp; Craft Market direkt neben der Rosebank Mall, wo es Kunsthandwerk aus ganz Afrika gibt, von Gemälden über Holzschnitzereien bis hin zu Schmuck und kleinen Möbelstücken</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "Rosebank Art &amp; Craft Market, Cradock Ave (next to Europa), Rosebank",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_7"
     },
