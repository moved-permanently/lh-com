     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Singapur",
      "variant": "HEADING_XL",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>17. Juni 2025 | 3 min read | Florian Tomberg</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_info"
     },
     {
      "type": "copyText",
      "text": "<b>Singapur erleben wie ein Insider: Purser Florian Tomberg nimmt uns mit auf seinen perfekten Tag in der asiatischen Metropole – voller kulinarischer Highlights und Geheimtipps.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Vormittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/a-perfect-day-in-singapore/jcr:content/articlecontentfragment/par0/image_645579844_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/asia/a-perfect-day-in-singapore/lh_app_watermelon-juice_shutterstock-1992470564_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Person hält Becher mit Wassermelonensaft"
     },
     {
      "type": "copyText",
      "text": "<b>Sportlich in den Tag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Mein Tipp gegen Jetlag: Sport. Morgens gehe ich deshalb erst einmal ins Fitnessstudio meines Hotels</li><li>Zur Erfrischung gönne ich mir danach einen frisch gepressten Orangensaft aus einer der vielen Maschinen, die überall auf Singapurs Straßen zu finden sind</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/asia/a-perfect-day-in-singapore_paragraph_2"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
