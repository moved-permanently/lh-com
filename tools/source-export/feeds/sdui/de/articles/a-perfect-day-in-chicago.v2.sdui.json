   {
    "type": "column",
    "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago",
    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Chicago",
      "variant": "HEADING_XL",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>9. Oktober 2025 | 2 min read | Peter Jilke</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_info"
     },
     {
      "type": "copyText",
      "text": "Schwimmen mit Blick auf Wolkenkratzer, eine Deep Dish Pizza und vieles mehr: Langstreckenpurser Peter-Jürgen Jilke verrät seine Tipps für einen unvergesslichen Tag in Chicago.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_separator"
     },
     {
      "type": "copyText",
      "text": "<b style=\"font-size: 16.0px;\">Vormittag</b>",
      "size": "MEDIUM",
      "variant": "HEADLINE",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/a-perfect-day-in-chicago/jcr:content/articlecontentfragment/par0/image_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/north-america/a-perfect-day-chicago/lh_app_chicago_lou-mitchells_coffee_alamy-T5DMN8_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Außenansicht des legendären Diners Lou Mitchell’s in Chicago mit gelben Sonnenschirmen und Gästen auf der Terrasse."
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/de/articles/a-perfect-day-in-chicago/jcr:content/articlecontentfragment/par0/separator"
     },
     {
      "type": "copyText",
      "text": "<b>Frühstück im Lou Mitchell’s</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>&nbsp;Der perfekte Tag in Chicago fängt für mich mit Frühstück im Diner Lou Mitchell’s an, das genau am Beginn der berühmten Route 66 liegt</li><li>Die Portionen dort sind üppig und die Pancakes schmecken phänomenal</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "565 W. Jackson Blvd",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Lake Michigan von oben</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Das Skydeck von Chicagos höchstem Wolkenkratzer, dem Willis Tower, ist ein Muss. Dort blickt man durch Glasböden auf die Stadt</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "233 S. Wacker Dr",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "<b>Mittag</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_7"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/de/articles/a-perfect-day-in-chicago/jcr:content/articlecontentfragment/par7/image_copy_198269851",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/north-america/a-perfect-day-chicago/lh_app_chicago_deep-dish-pizza_gettyimages1859952448_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Nahaufnahme einer traditionellen Deep-Dish-Pizza in einer gusseisernen Pfanne in Chicago."
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/de/articles/a-perfect-day-in-chicago/jcr:content/articlecontentfragment/par7/separator_copy"
     },
     {
      "type": "copyText",
      "text": "<b>Lunch in der Pizzeria Uno</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_8"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Die „Deep Dish Pizza“ mit besonders dickem Rand ist eine lokale Spezialität. Ich finde: Am besten schmeckt sie in der Pizzeria Uno</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_9"
     },
     {
      "type": "copyText",
      "text": "29 East Ohio St",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/de/mobile-app/north-america/a-perfect-day-in-chicago_paragraph_10"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/de/articles/a-perfect-day-in-chicago/jcr:content/articlecontentfragment/par10/separator_copy_copy_"
