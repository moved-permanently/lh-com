    "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong",
    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Hong Kong",
      "variant": "HEADING_XL",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 3 min read | Katja Tucich</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_info"
     },
     {
      "type": "copyText",
      "text": "<b>Purser Katja Tucich has been to her favorite city, Hong Kong, many times. She shares her tips for the metropolis, from great coffee in the morning to a nice drink at night.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Morning</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/asia/a-perfect-day-in-hong-kong/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/asia/a-perfect-day-in-hong-kong/lh_app_hongkong_noc-cafe_breakfast_c_jeremy-cheung_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Puff pastry with blueberries and an iced coffee on a white plate"
     },
     {
      "type": "copyText",
      "text": "<b>Coffee at NOC Coffee</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I start my day with a coffee at NOC Coffee on Whampoa Street</li><li>From there, I enjoy a fantastic view of the Hong Kong skyline</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "NOC Coffee, Shop G42, G/F, Whampoa Garden Site 9 Block 1, Tak Fung St, Hung Hom",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_3"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/asia/a-perfect-day-in-hong-kong/jcr:content/articlecontentfragment/par3/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/asia/a-perfect-day-in-hong-kong/lh_app_hongkong_island_getty505252214_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Hung Hom Promenade in Hong Kong with the city skyline and mountains in the background"
     },
     {
      "type": "copyText",
      "text": "<b>Walk Along the promenade</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "<ul><li>With coffee in hand, I stroll along the Hung Hom Promenade toward the Avenue of Stars</li><li>The handprints of Hong Kong cinema legends such as Jackie Chan and Wong Kar-wai celebrate the city’s film history</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "Avenue of Stars, Tsim Sha Tsui",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "<b>Midday</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_7"
     },
     {
      "type": "copyText",
      "text": "<b>Shopping on Mody Road</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_8"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I love browsing the small shops and street stalls along Mody Road</li><li>It’s a great place to find souvenirs, repair services, and bargains</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_9"
     },
     {
      "type": "copyText",
      "text": "Mody Road, Tsim Sha Tsui",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_10"
     },
     {
      "type": "copyText",
      "text": "<b>Discover Wong Tai Sin Temple</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_11"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/asia/a-perfect-day-in-hong-kong/jcr:content/articlecontentfragment/par11/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/asia/a-perfect-day-in-hong-kong/lh_app_hongkong_wong-tai-sim-temple_getty1751455646_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Wong Tai Sin Temple in Hong Kong with traditional roofs and the city skyline"
     },
     {
      "type": "copyText",
      "text": "<ul><li>The colorful Wong Tai Sin Temple is a must-see in Hong Kong</li><li>It is a fascinating place to learn more about local traditions and fortune telling rituals</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_12"
     },
     {
      "type": "copyText",
      "text": "Wong Tai Sin Temple, Chuk Un",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/asia/a-perfect-day-in-hong-kong_paragraph_13"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/en/articles/asia/a-perfect-day-in-hong-kong/jcr:content/articlecontentfragment/par13/separator_copy_copy_"
     },
