    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in London",
      "variant": "HEADING_XL",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>25. June 2025 | 3 min read | Stefanie Sauer</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_info"
     },
     {
      "type": "copyText",
      "text": "<b>Marvel at the skyline from London’s highest garden, shop in Soho, and be captivated by a West End show: Stefanie Sauer shows just how diverse a day in London can be.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Morning</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/a-perfect-day-in-london/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/europe/a-perfect-day-in-london/lh_app_london_sky-garden_shutterstock1303339738_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Sky Garden with a view of the London skyline"
     },
     {
      "type": "copyText",
      "text": "<b>Start Fresh at The Breakfast Club Soho&nbsp;</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>A vibrant interior with a cozy retro charm</li><li>My recommendation: order the Pancakes with Cream and Berries, or try the Eggs Benedict</li><li>Reservations aren’t possible, but a short wait is definitely worth it</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "33 D'Arblay St&nbsp;",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Admire the View From Sky Garden</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I love the panorama from the 360-degree viewing platform: it has bars, restaurants, and a fantastic view of the Thames and London skyline</li><li>The Sky Garden is open to the public and free of charge – if you get an advance ticket online. Tickets are limited, so I recommend booking early</li><li>My tip for early risers: sunrise yoga sessions are offered at 7 a.m. On weekends, classes start at&nbsp;8 a.m.</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "1 Sky Garden Walk, London, United Kingdom",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/europe/a-perfect-day-in-london_paragraph_6"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/en/articles/a-perfect-day-in-london/jcr:content/articlecontentfragment/par6/separator_copy_copy_"
