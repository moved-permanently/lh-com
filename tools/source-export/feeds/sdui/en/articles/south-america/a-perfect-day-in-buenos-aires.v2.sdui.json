    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Buenos Aires",
      "variant": "HEADING_XL",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 2 min read | Julia Buth</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_info"
     },
     {
      "type": "copyText",
      "text": "<b>Purser Julia Buth from Frankfurt regularly spends time in Buenos Aires and shares her top tips on how to spend the perfect day in the Argentinean capital.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Morning</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/south-america/a-perfect-day-in-buenos-aires/lh_app_buenos-aires_plaza-dorrego_tango_getty1211337952_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "A couple, the woman in a red dress, the man in a beige jacket and black trousers, are dancing the tango in an outdoor square"
     },
     {
      "type": "copyText",
      "text": "<b>Breakfast at Café Tortoni</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I always start my day at Café Tortoni, the city's oldest and most iconic café</li><li>I highly recommend the medialunas with dulce de leche – a true Argentine classic</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "Café Tortoni, Av. de Mayo 825",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Explore San Telmo</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "<ul><li>The historic San Telmo district is the perfect place to experience the vibrant street life of Buenos Aires</li><li>My tip: stroll around Plaza Dorrego and, on Sundays, visit the famous arts and crafts market</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "Plaza Dorrego, San Telmo",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "<b>Midday</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_7"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par7/image_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/south-america/a-perfect-day-in-buenos-aires/lh_app_buenos-aires_juan-pablo-mascanfroni_unsplash-1vumey9jdwk_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "View of the Galileo Galilei Planetarium in the Palermo district of Buenos Aires"
     },
     {
      "type": "copyText",
      "text": "<b>Empanadas at San Telmo Market</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_8"
     },
     {
      "type": "copyText",
      "text": "<ul><li>The historic San Telmo Market is one of my favorite places in the city</li><li>At El Hornero, you'll find empanadas with a wide variety of fillings – my favorites are the cheese empanadas</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_9"
     },
     {
      "type": "copyText",
      "text": "Mercado de San Telmo, Defensa 963, San Telmo",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_10"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/en/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par10/separator_copy"
