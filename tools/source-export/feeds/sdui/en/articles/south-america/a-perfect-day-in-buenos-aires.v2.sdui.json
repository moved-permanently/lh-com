     },
     {
      "type": "copyText",
      "text": "<b>Afternoon</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_11"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par11/image_copy_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/south-america/a-perfect-day-in-buenos-aires/lh_app_buenos-aires_la-boca_getty172800353_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "View of colorfully painted corrugated iron houses in the La Boca district of Buenos Aires."
     },
     {
      "type": "copyText",
      "text": "<b>Walk Through La Boca</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_12"
     },
     {
      "type": "copyText",
      "text": "<ul><li>La Boca is famous for its colorful buildings, street performers, and lively atmosphere</li><li>Soccer fans shouldn't miss a visit to the iconic La Bombonera stadium</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_13"
     },
     {
      "type": "copyText",
      "text": "La Bombonera, Brandsen 805, La Boca",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_14"
     },
     {
      "type": "copyText",
      "text": "<b>Evening</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_15"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/south-america/a-perfect-day-in-buenos-aires/jcr:content/articlecontentfragment/par15/image_copy_copy_copy",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/south-america/a-perfect-day-in-buenos-aires/lh_app_buenos-aires_palermo_p7e8rp_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "View of the Plaza Italia square in the Palermo district of Buenos Aires."
     },
     {
      "type": "copyText",
      "text": "<b>Dinner at Lo de Jesús</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_16"
     },
     {
      "type": "copyText",
      "text": "<ul><li>My favorite restaurant in Palermo is Lo de Jesús</li><li>I recommend the grilled provolone with creamy spinach – a delicious choice for vegetarians, too</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_17"
     },
     {
      "type": "copyText",
      "text": "Lo de Jesús, Gurruchaga 1406, Palermo",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_18"
     },
     {
      "type": "copyText",
      "text": "<b>Cocktails at Milión</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_19"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I love ending the day at Milión, a stylish bar set in a beautifully restored Belle Époque mansion.</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_20"
     },
     {
      "type": "copyText",
      "text": "Milión, Paraná 1048, Recoleta",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_21"
     },
     {
      "type": "copyText",
      "text": "Copyrights:&nbsp;Andrea Leopardi / Unsplash, Alamy Stock Photo, Getty Images (2), Juan Pablo Mascanfroni / Unsplash",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_22"
     },
     {
      "type": "copyText",
      "text": "<b>About</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_23"
     },
     {
      "type": "copyText",
      "text": "Julia Buth began as a flight attendant at Lufthansa in 2008, and has been a purser on long- and short-haul flights since 2023.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/south-america/a-perfect-day-in-buenos-aires_paragraph_24"
     }
