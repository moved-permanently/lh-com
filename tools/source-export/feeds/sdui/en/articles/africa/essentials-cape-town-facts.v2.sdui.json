     {
      "type": "mainHeadline",
      "text": "Essentials of Cape Town",
      "variant": "HEADING_XL",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 2 min read | Lufthansa Editorial Team</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_info"
     },
     {
      "type": "copyText",
      "text": "<b>Five things that will surprise you about Cape Town.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Cheers!</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_paragraph_0"
     },
     {
      "type": "copyText",
      "text": "Route 62 is the longest wine route in the world. Stretching around 850 kilometers (530 miles) from Cape Town to Gqeberha, it winds through some of South Africa’s finest winery regions.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_paragraph_1"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/africa/essentials-cape-town-facts/jcr:content/articlecontentfragment/par1/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/africa/essentials-cape-town/lh_app_capetown_illustration1_sylvia-neuner_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Illustration on the left: cars drive along a trail of wine running out of a bottle. Illustration on the right: a person rides down the sun on a sled."
     },
     {
      "type": "copyText",
      "text": "<b>What a ride!</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "Cape Town’s Bellville district is home to Africa’s first toboggan run. Called Cool Runnings, the track is just over half a mile long – and truly lives up to its name.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/essentials-cape-town-facts_paragraph_3"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
