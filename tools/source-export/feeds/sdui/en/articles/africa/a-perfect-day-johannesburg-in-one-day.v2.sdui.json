    "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day",
    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Johannesburg",
      "variant": "HEADING_XL",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 2 min read | Farah Benkassem</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_info"
     },
     {
      "type": "copyText",
      "text": "<b>Flight attendant Farah Benkassem regularly spends time in Johannesburg and shares her top tips for a relaxing day in South Africa's vibrant metropolis.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Morning</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/africa/a-perfect-day-johannesburg-in-one-day/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/africa/perfect-day-johannesburg/lh_app_johannesburg_tashacafeb_breakfast_image-18_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Breakfast plate with fruit, yoghurt, and muesli"
     },
     {
      "type": "copyText",
      "text": "<b>Breakfast at Tashas</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I always start my day with a relaxed breakfast at Tashas in the Melrose Arch business district</li><li>I highly recommend the avocado milkshake and the hummus and avocado toastie</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "Tashas Melrose Arch, The Piazza, 14 Whiteley Rd, Melrose",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Midday</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_4"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/africa/a-perfect-day-johannesburg-in-one-day/jcr:content/articlecontentfragment/par4/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/africa/perfect-day-johannesburg/lh_app_johannesburg_rosebank_gettyimages1208969350_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Rosebank neighborhood in Johannesburg"
     },
     {
      "type": "copyText",
      "text": "<b>Shopping in Rosebank</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "<ul><li>The Rosebank district has plenty of modern shopping malls and galleries to browse</li><li>My tip: the Art &amp; Craft Market right next to Rosebank Mall, where you'll find handcrafted treasures from across Africa, from paintings and wood carvings to jewelry and small pieces of furniture</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "Rosebank Art &amp; Craft Market, Cradock Ave (next to Europa), Rosebank",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_7"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
