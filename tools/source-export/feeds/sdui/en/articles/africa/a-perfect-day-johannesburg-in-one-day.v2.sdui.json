      "size": "MEDIUM",
      "id": "/content/mobile/lh/en/articles/africa/a-perfect-day-johannesburg-in-one-day/jcr:content/articlecontentfragment/par7/separator_copy_copy__1501143661"
     },
     {
      "type": "copyText",
      "text": "<b>Evening</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_8"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/africa/a-perfect-day-johannesburg-in-one-day/jcr:content/articlecontentfragment/par8/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/africa/perfect-day-johannesburg/lh_app_johannesburg_marble-restaurant_shutterstock129816269_1920x823.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "Raw salmon served in the restaurant"
     },
     {
      "type": "copyText",
      "text": "<b>Cocktails and Dinner at Marble</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_9"
     },
     {
      "type": "copyText",
      "text": "<ul><li>Marble in Rosebank is one of my favorite restaurants – a contemporary grill house with an open kitchen and stunning sunset views</li><li>My recommendation: order the coal-fired rib-eye with the house Jack Daniel's sauce, and be sure to reserve a table in advance</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_10"
     },
     {
      "type": "copyText",
      "text": "Marble Restaurant, Trumpet on Keyes, Keyes &amp; Jellicoe Ave, Rosebank",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_11"
     },
     {
      "type": "copyText",
      "text": "<b>Live Music at Katzy's</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_12"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I love ending the day at Katzy's: live blues, smooth jazz, and Motown classics create the perfect relaxed atmosphere</li><li>Katzy’s Wine Bar, The Firs/Hyatt Shopping Mall, Oxford Road &amp; Bierman Ave, Rosebank</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_13"
     },
     {
      "type": "copyText",
      "text": "Copyrights:&nbsp;Getty Images (2), PR, Shutterstock",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_14"
     },
     {
      "type": "copyText",
      "text": "<b>About</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_15"
     },
     {
      "type": "copyText",
      "text": "Farah Benkassem has been a Lufthansa flight attendant for seven years. When traveling to South Africa, she enjoys being able to get straight back to her daily routine due to the minimal time difference.",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-johannesburg-in-one-day_paragraph_16"
     }
