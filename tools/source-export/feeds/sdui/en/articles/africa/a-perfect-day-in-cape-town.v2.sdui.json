    "items": [
     {
      "type": "mainHeadline",
      "text": "A Perfect Day in Cape Town",
      "variant": "HEADING_XL",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_title",
      "isBold": true
     },
     {
      "type": "copyText",
      "text": "<b>15. September 2026 | 2 min read | Till Nawrath</b>",
      "size": "SMALL",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_info"
     },
     {
      "type": "copyText",
      "text": "<b>Purser Till Nawrath is a true expert on Cape Town. In this article, he shares what he considers to be the essential elements of a perfect day at the foot of Table Mountain.</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_description_0"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_separator"
     },
     {
      "type": "copyText",
      "text": "<b>Morning</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_0"
     },
     {
      "type": "image",
      "id": "/content/mobile/lh/en/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par0/image",
      "url": "https://www.lufthansa.com/content/dam/lh/article-images/mobile-app/africa/perfect-day-cape-town/lh_app_capetown_kanela-cafe_image00020_1920x1080.jpg.transform/lh-dcep-transform-width-1440/img.jpg",
      "contentDescription": "A cup with coffee and milk foam with a heart"
     },
     {
      "type": "copyText",
      "text": "<b>Coffee at Ground Art Caffe</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_1"
     },
     {
      "type": "copyText",
      "text": "<ul><li>I start my day with a flat white at Ground Art Caffe in the De Waterkant neighborhood</li><li>This stylish café is the perfect place for a relaxed start to the day</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_2"
     },
     {
      "type": "copyText",
      "text": "Ground Art Caffe, 160 Strand St, De Waterkant",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_3"
     },
     {
      "type": "copyText",
      "text": "<b>Hike Up Lion's Head</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_4"
     },
     {
      "type": "copyText",
      "text": "<ul><li>A morning hike up Lion's Head is always worth it</li><li>At the summit, you'll be rewarded with one of the best views of Cape Town, Table Mountain, and the ocean</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_5"
     },
     {
      "type": "copyText",
      "text": "Lion's Head, Signal Hill",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_6"
     },
     {
      "type": "copyText",
      "text": "<b>Midday</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_7"
     },
     {
      "type": "copyText",
      "text": "<b>Lunch at Kanéla Café</b>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_8"
     },
     {
      "type": "copyText",
      "text": "<ul><li>After the hike, I treat myself to avocado toast at Kanéla Café</li><li>My favorite spot is the sunny courtyard by the fountain</li></ul>",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_9"
     },
     {
      "type": "copyText",
      "text": "Kanéla Café, 78 Regent Rd, Sea Point",
      "size": "MEDIUM",
      "variant": "BODY",
      "id": "/lh/en/mobile-app/africa/a-perfect-day-in-cape-town_paragraph_10"
     },
     {
      "type": "spacer",
      "size": "MEDIUM",
      "id": "/content/mobile/lh/en/articles/africa/a-perfect-day-in-cape-town/jcr:content/articlecontentfragment/par10/separator_copy_copy_"
