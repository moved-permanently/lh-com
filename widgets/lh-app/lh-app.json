        "common.misc.loader.label": "Loading …"
      },
      "de": {
        "common.misc.loader.forcedOneIdLoginText": "Bitte loggen Sie sich ein.",
        "common.misc.loader.forcedOneIdLoginButton": "Jetzt einloggen",
        "common.misc.loader.label": "Wird geladen..."
      }
    }
  },
