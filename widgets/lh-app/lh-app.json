    "loginStatusPath": "/v1/user/me/loginstatus",
    "profileApi": "/service/secured/api/core/user/profile",
    "authorize": {
      "url": "{travelIdApi}/oauth2/authorize",
      "clientId": "yA8iz2C5BnAIf2GKKdkAlgPPW9y6wjLO",
      "redirectUri": "https://www.lufthansa.com",
      "scope": "AUTHENTICATED IDENTIFIED urn:milesandmore:tech:background:v1:active urn:milesandmore:oauth:multifactorauthentication",
      "extra": "principal_type=EMAIL&reduced_state=NONE&view=login&prompt=login"
    },
    "maui": {
      "css": "/digitalhangar/design-system/releases/v1.38.0/standalone/css/lufthansa.css",
      "js": "/digitalhangar/design-system/releases/v1.38.0/standalone/packages/maui-design-system.js"
    },
    "portal": { "X-Portal": "LH", "X-Line": "g" },
    "labels": {
